# Environment variables required by the /api serverless functions.
# Set these in the Vercel dashboard (Project → Settings → Environment Variables)
# for the Production and Preview environments. Do NOT commit real values.

# The shared access code your friends type on the login screen.
ACCESS_CODE=

# A long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase service-role key (Supabase dashboard → Project Settings → API →
# "service_role" secret). Server-side only — never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — defaults to the project URL in code if omitted.
SUPABASE_URL=https://sinjmdlhabgywoavwjkl.supabase.co
